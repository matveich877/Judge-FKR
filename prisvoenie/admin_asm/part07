}

function exportRequests(){
  const list=getRequests();
  let csv='\ufeffID;Дата заявки;ФИО;Email;Регион;Тариф;Сумма;Канал;Статус;Оплачено;Ключ выдан;Ключ;Комментарий\n';
  list.forEach(r=>{
    const t=tariffById(r.tariffId);
    csv+=[r.id,fmtDateTime(r.createdAt),r.fio,r.email,r.region||'',t?t.name:'',t?t.price:'',r.channel||'',REQ_STATUSES[r.status]||r.status,fmtDate(r.paidAt),fmtDate(r.issuedAt),r.keyCode||'',r.comment||''].map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')+'\n';
  });
  const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='zayavki_ktss_'+new Date().toISOString().split('T')[0]+'.csv';
  a.click();
}

