function attachExistingKey(reqId){
  const r=getRequests().find(x=>x.id===reqId);if(!r)return;
  const code=prompt('Вставьте код готового ключа (KTSS2-...):');
  if(!code)return;
  const parsed=parseSignedKey(code.trim());
  if(!parsed){alert('❌ Ключ не распознан или подпись не сошлась. Проверьте код.');return}
  r.keyCode=code.trim();
  setReqStatus(reqId,'issued');
  alert('✓ Ключ привязан к заявке '+reqId);
}
function mailKeyTo(reqId){
  const r=getRequests().find(x=>x.id===reqId);if(!r||!r.keyCode)return;
